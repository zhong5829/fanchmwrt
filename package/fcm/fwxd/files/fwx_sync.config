# Terminal snapshot exchange between mesh nodes (LAN only).
# The token is a shared secret; keep it identical on every node.
config sync 'sync'
	option enable '1'
	option token '18b8c633df88be48dd27d4b8884e2abb'
	option port '8787'
	option interval '5'
	list peers '192.168.110.1'
	list peers '192.168.110.2'
	list peers '192.168.110.3'
